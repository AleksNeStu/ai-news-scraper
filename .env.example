# =====================================================
# AI News Scraper — Environment variables
# =====================================================
#
# This file documents the env var schema for two deploy shapes:
#
# 1) LOCAL DEV (docker-compose): copy this to .env (gitignored) and fill
#    in real values. Each var lives in the docker-compose.yml environment:
#    block; pydantic-settings reads them at api startup.
#
# 2) PROD (Render Blueprint): the canonical source of truth for prod is
#    the render.yaml Blueprint + the Render dashboard "sync: false" keys.
#    Do NOT commit a .env.production file — Render reads env from the
#    dashboard. See docs/operations/deploy.md §2 for which keys are which.
#
# Every var below is declared on ``Settings`` in apps/api/api/config.py.
# Most have a sane local default; lines left EMPTY are optional and only
# become required when the matching feature is enabled.
#
# Set APP_ENV=production for prod. Set to "test" to bypass external
# integrations during pytest.

# ---------- General ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Backend (apps/api) ----------
API_HOST=0.0.0.0
API_PORT=8082
# INSIDE the compose network, the api service reaches itself as
# http://api:8082. Outside (browser, host curl), use the public URL.
API_INTERNAL_URL=http://api:8082

# ---------- Database (Postgres) ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_news
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ai_news

# ---------- Vector DB (ChromaDB) ----------
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Persistent vector dir when running outside compose. Inside compose the
# chromadb container owns this on its own volume.
CHROMA_PERSIST_DIR=./chroma_db

# ---------- Cache (Redis) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- AI providers ----------
# OPENAI_API_KEY: required for the AI brief pipeline. With the
# placeholder ``sk-replace-me`` (or empty), /scrape still works but
# falls back to NLTK extractive summaries, and the digest cron is
# silently disabled (see apps/api/api/main.py lifespan).
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
EMBEDDING_DIMENSIONS=1536

# ---------- Multi-provider LLM routing (ADR-011) ----------
# The active LLM provider is selected by LLM_PROVIDER; the matching
# per-provider API key below is required when that provider is selected.
# The OpenAI key above is kept for backward compatibility with the
# original brief pipeline.
LLM_PROVIDER=deepseek
# Optional override; leave blank to use the provider's default model.
LLM_MODEL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY mirrors GEMINI_API_KEY per the TaskMaster config convention.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ---------- Auth ----------
# JWT_SECRET signs session JWTs. MUST be a 64-char random string in prod.
# The placeholder ``change-me-in-production-...`` is rejected at runtime
# (see apps/api/api/services/auth.py).
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=1440

# ---------- RSS ----------
RSS_POLL_INTERVAL_SEC=900
RSS_MAX_ITEMS_PER_POLL=50
RSS_USER_AGENT=ai-news-scraper/0.1

# ---------- CORS ----------
# JSON list of allowed browser origins. In production (Option A —
# Dokploy reverse proxy on a single host), set this to the public web
# origin, e.g. ["https://app.your-domain.com"]. The default
# localhost is fine for dev; it WILL block prod browser calls.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# ---------- SMTP (digest email) ----------
# Required only if DIGEST_ENABLED=true and you want email delivery.
# With SMTP_HOST empty, the email worker logs and bails (in-app only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Full from-address; falls back to localhost if malformed.
SMTP_FROM=

# ---------- AI brief kill switches ----------
# DIGEST_ENABLED is the primary switch for the AI-brief cron + router.
# BRIEF_DISABLED is a back-compat alias. Set DIGEST_ENABLED=false to
# disable the brief pipeline entirely (digest router 404s).
DIGEST_ENABLED=true
BRIEF_DISABLED=false

# ---------- RFC 8058 unsubscribe JWT ----------
# Signs one-click unsubscribe tokens (POST /unsubscribe). REQUIRED if
# DIGEST_ENABLED=true and SMTP_HOST is set. Use a different random
# string from JWT_SECRET. Empty default = /unsubscribe 500s.
UNSUBSCRIBE_JWT_SECRET=

# ---------- Frontend (apps/web) ----------
# Public origin of the API as seen by the browser. For local compose
# this is the api service on the host network (http://localhost:8082).
# For Render prod this is a relative path: same-origin relative URLs
# (/api/backend) flow through Next.js's rewrite at apps/web/next.config.ts
# against the public onrender.com URL exposed by the api service.
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_APP_URL=https://ai-news-scraper-web.onrender.com
NEXT_PUBLIC_APP_NAME="AI News Scraper"

# ---------- Observability (ADR-016) ----------
# Sentry server-side DSN (api). Empty default → ``init_sentry()`` is a
# silent no-op so dev environments run without the SDK. Production must
# set the real DSN (gitleaks + the private-leak-check gate forbid real
# values in any tracked file). The matching browser DSN lives in the
# web tree under ``NEXT_PUBLIC_SENTRY_DSN``.
SENTRY_DSN=
# Shared by api + web. Set at deploy time from ``git rev-parse --short HEAD``
# so api + web report the same release row. Empty → "unknown" in Sentry.
SENTRY_RELEASE=
# Uptime Kuma alerting — Telegram channel. Empty ``TELEGRAM_BOT_TOKEN``
# disables the channel; Kuma logs a warning rather than failing closed
# (see ADR-016 §16.3 alerting rules).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Observability (web) ----------
# Sentry browser DSN. Empty default → apps/web/sentry.client.config.ts
# + apps/web/sentry.server.config.ts skip init and the web runs without
# the SDK (graceful no-op, §16.9). Pairs with SENTRY_DSN above; both DSNs
# target the SAME Sentry project so the operator sees api + browser
# errors side-by-side.
NEXT_PUBLIC_SENTRY_DSN=
# Optional override for the Sentry ``environment`` tag on the browser
# runtime. Priority is NEXT_PUBLIC_APP_ENV → NODE_ENV → 'development'.
# NODE_ENV is the safe runtime default (Next.js sets it correctly:
# 'development' in ``next dev``, 'production' in ``next start``). Set
# this var only when you need a custom environment name (e.g. 'staging')
# for a separate Sentry bucket.
NEXT_PUBLIC_APP_ENV=
# Build-time only. Source-map upload runs only when SENTRY_UPLOAD=true
# (see apps/web/next.config.ts dryRun branch, §16.7). NEVER commit a
# real token; the tracked apps/web/.sentryclirc.example is schema-only.
SENTRY_AUTH_TOKEN=
SENTRY_UPLOAD=false
SENTRY_ORG=
SENTRY_PROJECT=
