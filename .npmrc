# pnpm workspace config — see https://pnpm.io/npmrc
#
# ``node-linker=hoisted`` switches pnpm from the default symlinked
# layout (packages live in ``.pnpm/`` and are referenced via symlinks
# from each workspace package) to a flat layout where every dependency
# is hoisted to the nearest ``node_modules``. Next.js 15 + pnpm 9.12
# do not resolve symlinks consistently in some build paths — e.g.
# ``apps/web/node_modules/next/dist/bin/next`` — which causes
# ``next build`` to fail with ``Cannot find module .../next/dist/bin/next``
# even when ``next`` is installed. The flat layout eliminates the
# symlink chain that Next.js's CLI cannot follow on Alpine / Docker.
# The lockfile is unchanged (resolution is the same); only on-disk
# placement differs.
node-linker=hoisted